#!/usr/bin/env python3
"""The sound-event classifier kilix-nvr talks to.

Same 480-byte contract as the object detector: read one window of 16 kHz
mono s16le from stdin, write float32[20][6] to stdout with [class, score]
in the first two columns.  The remaining four are unused for audio and
left zero rather than repurposed, so one reader handles both replies.

Without a model this reports nothing, which is the honest answer: the
caller keeps recording and keeps seeing.
"""
import argparse
import struct
import sys

ROWS, COLUMNS = 20, 6
RATE = 16000
WINDOW_BYTES = RATE * 2

# Must match the allowlist in knvr_sound.c.
CLASSES = ["speech", "shout", "dog", "glass", "alarm", "siren", "gunshot",
           "vehicle", "knock"]


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--model", default=None,
                        help="a classifier; without one nothing is reported")
    parser.add_argument("--conf", type=float, default=0.5)
    options = parser.parse_args()

    model = None
    if options.model:
        try:
            import onnxruntime
            model = onnxruntime.InferenceSession(options.model)
        except Exception as problem:                  # noqa: BLE001
            print(f"kilix-nvr-listen: {options.model}: {problem}",
                  file=sys.stderr, flush=True)

    stdin, stdout = sys.stdin.buffer, sys.stdout.buffer
    while True:
        chunks, remaining = [], WINDOW_BYTES
        while remaining > 0:
            chunk = stdin.read(remaining)
            if not chunk:
                return 0
            chunks.append(chunk)
            remaining -= len(chunk)
        rows = [0.0] * (ROWS * COLUMNS)
        if model is not None:
            try:
                import numpy as np

                samples = np.frombuffer(b"".join(chunks), dtype=np.int16)
                samples = samples.astype(np.float32) / 32768.0
                name = model.get_inputs()[0].name
                scores = model.run(None, {name: samples[None, :]})[0][0]
                order = scores.argsort()[::-1][:ROWS]
                for slot, index in enumerate(order):
                    if float(scores[index]) < options.conf:
                        break
                    rows[slot * COLUMNS + 0] = float(index)
                    rows[slot * COLUMNS + 1] = float(scores[index])
            except Exception as problem:              # noqa: BLE001
                print(f"kilix-nvr-listen: {problem}", file=sys.stderr,
                      flush=True)
        stdout.write(struct.pack("<%df" % (ROWS * COLUMNS), *rows))
        stdout.flush()


if __name__ == "__main__":
    sys.exit(main())
