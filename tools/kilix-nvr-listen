#!/usr/bin/env python3
"""The sound-event classifier kilix-nvr talks to.

Same 480-byte contract as the object detector: read one window of 16 kHz
mono s16le from stdin, write float32[20][6] to stdout with [class, score]
in the first two columns.  The remaining four are unused for audio and
left zero rather than repurposed, so one reader handles both replies.

The model is YAMNet - MobileNet v1 over log-mel patches, 521 AudioSet
classes, Apache-2.0, about 4 MB - chosen because it is the only capable
audio tagger whose input is already what this pipe carries: 16 kHz mono
waveform, just under a second at a time.  Everything else in its class
wants 32 kHz and a PyTorch runtime.  See docs/SOUND-MODEL.md.

Its 521 classes are not what a recorder reports.  A handful of them are,
so this maps AudioSet names onto the nine kilix sound classes and takes
the strongest member of each group.  Mapping by *name* rather than by
index is deliberate: the label list travels inside the model file, so a
different or newer model re-resolves rather than silently reporting
"gunshot" for whatever now sits at index 421.

Without a model this reports nothing, which is the honest answer: the
caller keeps recording and keeps seeing.

  --model FILE      a .tflite (YAMNet) or .onnx classifier
  --conf F          drop rows below this score, default 0.5
  --list-classes    print the AudioSet mapping and exit
  --wav FILE        classify a wav file and exit, for checking a model
"""
import argparse
import os
import struct
import sys
import zipfile

ROWS, COLUMNS = 20, 6
RATE = 16000
WINDOW_BYTES = RATE * 2

# Must match the allowlist in knvr_sound.c: the id is the wire contract,
# the name is what the C side prints.
CLASSES = ["speech", "shout", "dog", "glass", "alarm", "siren", "gunshot",
           "vehicle", "knock"]

# AudioSet display names per kilix class.  A group scores as its loudest
# member, because "Bark" and "Bow-wow" are the same dog and summing them
# would make a confident dog out of two uncertain ones.
GROUPS = {
    "speech": ["Speech", "Child speech, kid speaking", "Conversation",
               "Narration, monologue"],
    "shout": ["Shout", "Bellow", "Whoop", "Yell", "Children shouting",
              "Screaming"],
    "dog": ["Dog", "Bark", "Yip", "Howl", "Bow-wow", "Growling",
            "Whimper (dog)"],
    "glass": ["Glass", "Chink, clink", "Shatter", "Breaking"],
    "alarm": ["Alarm", "Alarm clock", "Buzzer", "Smoke detector, smoke alarm",
              "Fire alarm", "Car alarm"],
    "siren": ["Siren", "Civil defense siren", "Police car (siren)",
              "Ambulance (siren)", "Fire engine, fire truck (siren)",
              "Emergency vehicle"],
    "gunshot": ["Gunshot, gunfire", "Machine gun", "Fusillade",
                "Artillery fire", "Cap gun"],
    "vehicle": ["Vehicle", "Car", "Truck", "Bus", "Motorcycle",
                "Car passing by", "Motor vehicle (road)"],
    "knock": ["Knock", "Door", "Doorbell", "Ding-dong", "Slam"],
}

MODEL_NAMES = ("yamnet.tflite", "sound.tflite", "sound.onnx")


def default_model():
    """Where `kilix-nvr-fetch-model` puts it, honouring KILIX_NVR_HOME."""
    home = os.environ.get("KILIX_NVR_HOME")
    if not home:
        base = os.environ.get("XDG_DATA_HOME") or os.path.expanduser(
            "~/.local")
        home = os.path.join(base, "gpu_terminal", "kilix-nvr")
    for name in MODEL_NAMES:
        candidate = os.path.join(home, "models", name)
        if os.path.exists(candidate):
            return candidate
    return None


def model_labels(path):
    """YAMNet's label list rides inside the .tflite as an appended zip.

    A sibling .labels.txt wins if present, so a model without embedded
    metadata is still usable without patching this.
    """
    sibling = os.path.splitext(path)[0] + ".labels.txt"
    if os.path.exists(sibling):
        with open(sibling, "r", encoding="utf-8") as handle:
            return [line.strip() for line in handle if line.strip()]
    try:
        with zipfile.ZipFile(path) as bundle:
            for entry in bundle.namelist():
                if entry.endswith(".txt"):
                    text = bundle.read(entry).decode("utf-8")
                    return [line.strip() for line in text.splitlines()
                            if line.strip()]
    except (zipfile.BadZipFile, KeyError, UnicodeDecodeError):
        pass
    return []


def build_mapping(labels):
    """kilix class id -> the model output indices that feed it.

    Names that the model does not have are returned separately rather
    than dropped: a group that has quietly lost its members reports
    nothing forever, and nothing is indistinguishable from silence.
    """
    index_of = {}
    for index, label in enumerate(labels):
        index_of.setdefault(label, index)
    mapping, missing = {}, []
    for class_id, name in enumerate(CLASSES):
        found = []
        for wanted in GROUPS[name]:
            if wanted in index_of:
                found.append(index_of[wanted])
            else:
                missing.append((name, wanted))
        mapping[class_id] = found
    return mapping, missing


class Model:
    """A tflite or onnx classifier, behind the one call this needs."""

    def __init__(self, path):
        self.path = path
        self.samples = None
        self._run = None
        if path.endswith(".onnx"):
            import onnxruntime

            session = onnxruntime.InferenceSession(
                path, providers=["CPUExecutionProvider"])
            spec = session.get_inputs()[0]
            shape = [d for d in spec.shape if isinstance(d, int)]
            self.samples = shape[-1] if shape else RATE

            def run(waveform):
                return session.run(None, {spec.name: waveform})[0]

            self._run = run
            return

        try:
            from ai_edge_litert.interpreter import Interpreter
        except ImportError:
            from tflite_runtime.interpreter import Interpreter

        # One thread: inference is ~3.5 ms per window against a second of
        # audio, so this is 0.4% of a core.  Taking more would be taking
        # them from the decode.
        interpreter = Interpreter(model_path=path, num_threads=1)
        interpreter.allocate_tensors()
        source = interpreter.get_input_details()[0]
        sink = interpreter.get_output_details()[0]
        self.samples = int(source["shape"][-1])

        def run(waveform):
            interpreter.set_tensor(source["index"], waveform)
            interpreter.invoke()
            return interpreter.get_tensor(sink["index"])

        self._run = run

    def scores(self, samples):
        """Scores for one window of float32 samples in -1..1."""
        import numpy as np

        want = self.samples
        if len(samples) > want:
            # The newest audio, not the oldest: the window is a second
            # long and the model wants 0.975 of it.
            samples = samples[-want:]
        elif len(samples) < want:
            samples = np.pad(samples, (want - len(samples), 0))
        out = self._run(np.ascontiguousarray(samples, dtype="float32"))
        return np.asarray(out).reshape(-1)


def classify(model, mapping, samples, conf):
    """(class_id, score) for every kilix class over the threshold."""
    scores = model.scores(samples)
    found = []
    for class_id, indices in mapping.items():
        best = 0.0
        for index in indices:
            if index < len(scores) and float(scores[index]) > best:
                best = float(scores[index])
        if best >= conf:
            found.append((class_id, best))
    found.sort(key=lambda row: row[1], reverse=True)
    return found[:ROWS]


def pack(found):
    rows = [0.0] * (ROWS * COLUMNS)
    for slot, (class_id, score) in enumerate(found):
        rows[slot * COLUMNS + 0] = float(class_id)
        rows[slot * COLUMNS + 1] = float(score)
    return struct.pack("<%df" % (ROWS * COLUMNS), *rows)


def load(path, conf):
    """The model and its mapping, or (None, None) with a reason on stderr.

    Every failure here is survivable: the caller degrades that camera to
    sight-only and keeps recording.
    """
    if not path:
        print("kilix-nvr-listen: no model; run kilix-nvr-fetch-model",
              file=sys.stderr, flush=True)
        return None, None
    try:
        model = Model(path)
    except Exception as problem:                      # noqa: BLE001
        print(f"kilix-nvr-listen: {path}: {problem}", file=sys.stderr,
              flush=True)
        return None, None
    labels = model_labels(path)
    if not labels:
        print(f"kilix-nvr-listen: {path}: no label list; cannot map its "
              "classes onto sound events", file=sys.stderr, flush=True)
        return None, None
    mapping, missing = build_mapping(labels)
    if missing:
        print("kilix-nvr-listen: this model has no "
              + ", ".join(f"{name}:{wanted}" for name, wanted in missing),
              file=sys.stderr, flush=True)
    empty = [CLASSES[class_id] for class_id, rows in mapping.items()
             if not rows]
    if empty:
        print("kilix-nvr-listen: nothing maps to " + ", ".join(empty),
              file=sys.stderr, flush=True)
    print(f"kilix-nvr-listen: {os.path.basename(path)}, "
          f"{len(labels)} classes, {model.samples} samples per window, "
          f"conf {conf}", file=sys.stderr, flush=True)
    return model, mapping


def read_wav(path):
    """A wav file as float32 mono at 16 kHz.

    `wave` plus numpy rather than audioop, which was removed in Python
    3.13; this has to keep working on hosts newer than the one it was
    written on.
    """
    import wave

    import numpy as np

    with wave.open(path, "rb") as handle:
        width = handle.getsampwidth()
        channels = handle.getnchannels()
        rate = handle.getframerate()
        frames = handle.readframes(handle.getnframes())
    if width == 1:
        samples = (np.frombuffer(frames, dtype=np.uint8).astype("float32")
                   - 128.0) / 128.0
    elif width == 2:
        samples = np.frombuffer(frames, dtype="<i2").astype("float32") / 32768.0
    elif width == 4:
        samples = np.frombuffer(frames, dtype="<i4").astype("float32") / \
            2147483648.0
    else:
        raise ValueError(f"{width * 8}-bit wav is not supported")
    if channels > 1:
        samples = samples.reshape(-1, channels).mean(axis=1)
    if rate != RATE:
        # Linear interpolation.  This is for auditioning a model against
        # a known sound, not for the live path, which arrives at 16 kHz
        # already because ffmpeg was told to.
        count = int(len(samples) * RATE / rate)
        samples = np.interp(np.linspace(0.0, len(samples) - 1.0, count),
                            np.arange(len(samples)), samples).astype("float32")
    return samples


def command_wav(model, mapping, path, conf):
    """Classify a file a window at a time - how a model gets checked
    against a known sound without waiting for a camera to hear one."""
    samples = read_wav(path)
    step = RATE
    heard = {}
    for start in range(0, max(len(samples) - step + 1, 1), step):
        for class_id, score in classify(model, mapping,
                                        samples[start:start + step], conf):
            heard[class_id] = max(heard.get(class_id, 0.0), score)
    if not heard:
        print(f"{os.path.basename(path)}: nothing over {conf}")
        return 1
    for class_id, score in sorted(heard.items(), key=lambda row: -row[1]):
        print(f"{os.path.basename(path)}: {CLASSES[class_id]} {score:.2f}")
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--model", default=None)
    parser.add_argument("--conf", type=float, default=0.5)
    parser.add_argument("--list-classes", action="store_true")
    parser.add_argument("--wav", default=None)
    options = parser.parse_args()

    path = options.model or default_model()
    model, mapping = load(path, options.conf)

    if options.list_classes:
        if mapping is None:
            return 1
        labels = model_labels(path)
        for class_id, indices in sorted(mapping.items()):
            names = ", ".join(labels[i] for i in indices)
            print(f"{class_id} {CLASSES[class_id]:8s} {names}")
        return 0

    if options.wav:
        if model is None:
            return 1
        return command_wav(model, mapping, options.wav, options.conf)

    stdin, stdout = sys.stdin.buffer, sys.stdout.buffer
    while True:
        chunks, remaining = [], WINDOW_BYTES
        while remaining > 0:
            chunk = stdin.read(remaining)
            if not chunk:
                return 0
            chunks.append(chunk)
            remaining -= len(chunk)
        found = []
        if model is not None:
            try:
                import numpy as np

                window = np.frombuffer(b"".join(chunks), dtype="<i2")
                found = classify(model, mapping,
                                 window.astype("float32") / 32768.0,
                                 options.conf)
            except Exception as problem:              # noqa: BLE001
                # Reported once and then muted: a model that throws on
                # every window would write a line per second forever.
                print(f"kilix-nvr-listen: {problem}", file=sys.stderr,
                      flush=True)
                model = None
        stdout.write(pack(found))
        stdout.flush()


if __name__ == "__main__":
    sys.exit(main())
