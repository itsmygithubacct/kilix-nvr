#!/usr/bin/env python3
"""Fetch the sound-event model, pinned by hash.

The weights are not in this repository and will not be: they are 4 MB of
someone else's Apache-2.0 artefact, and vendoring them means shipping a
copy that can drift from the one it claims to be.  Instead the exact URL
and its sha256 are pinned here, and what lands on disk is checked against
the hash before anything is allowed to use it.

A provenance file is written beside the model recording where it came
from, when, and under what licence.  That file is the answer to "what is
this thing and may we use it", asked six months later by someone who was
not here.

  kilix-nvr-fetch-model            fetch what is missing
  kilix-nvr-fetch-model --check    verify what is already there
  kilix-nvr-fetch-model --print    show the pins and where they go
"""
import argparse
import hashlib
import os
import shutil
import sys
import tempfile
import urllib.request

MODELS = {
    "sound": {
        "file": "yamnet.tflite",
        "url": "https://storage.googleapis.com/mediapipe-models/"
               "audio_classifier/yamnet/float32/1/yamnet.tflite",
        "sha256": "4d8b4a53282dc83ef04e3e7dbc4fbc98082e34e44ed798e16c3a0"
                  "cdd4c584faf",
        "what": "YAMNet, MobileNet v1 over log-mel patches, 521 AudioSet "
                "classes, 16 kHz mono, 15600 samples per window",
        "licence": "Apache-2.0 (Kaggle model google/yamnet reports "
                   "licenseName 'Apache 2.0'; published by Google in the "
                   "TensorFlow Model Garden and redistributed on Google's "
                   "mediapipe-models bucket)",
        "attribution": "Class names come from the AudioSet ontology "
                       "(Gemmeke et al., ICASSP 2017), CC BY 4.0.",
    },
}


def models_dir():
    home = os.environ.get("KILIX_NVR_HOME")
    if not home:
        base = os.environ.get("XDG_DATA_HOME") or os.path.expanduser(
            "~/.local")
        home = os.path.join(base, "gpu_terminal", "kilix-nvr")
    return os.path.join(home, "models")


def digest(path):
    hasher = hashlib.sha256()
    with open(path, "rb") as handle:
        for block in iter(lambda: handle.read(1 << 20), b""):
            hasher.update(block)
    return hasher.hexdigest()


def provenance(model, path, url):
    return (
        f"model: {model['file']}\n"
        f"what: {model['what']}\n"
        f"source: {url}\n"
        f"sha256: {model['sha256']}\n"
        f"licence: {model['licence']}\n"
        f"attribution: {model['attribution']}\n"
        f"fetched-by: kilix-nvr-fetch-model into {path}\n"
    )


def fetch(name, model, directory, force):
    path = os.path.join(directory, model["file"])
    if os.path.exists(path) and not force:
        actual = digest(path)
        if actual == model["sha256"]:
            print(f"{name}: {path} already correct")
            return 0
        print(f"{name}: {path} has sha256 {actual}, expected "
              f"{model['sha256']}; refusing to overwrite - move it aside "
              "or pass --force", file=sys.stderr)
        return 1

    os.makedirs(directory, mode=0o700, exist_ok=True)
    handle, temporary = tempfile.mkstemp(dir=directory, suffix=".part")
    os.close(handle)
    try:
        print(f"{name}: fetching {model['url']}")
        with urllib.request.urlopen(model["url"], timeout=120) as source, \
                open(temporary, "wb") as sink:
            shutil.copyfileobj(source, sink)
        actual = digest(temporary)
        if actual != model["sha256"]:
            # Hash first, install second.  A model that is not the model
            # this was written against is worse than no model: it answers
            # confidently in an ontology nobody checked.
            print(f"{name}: downloaded sha256 {actual}, expected "
                  f"{model['sha256']}; not installing", file=sys.stderr)
            return 1
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
        temporary = None
    except OSError as problem:
        print(f"{name}: {problem}", file=sys.stderr)
        return 1
    finally:
        if temporary and os.path.exists(temporary):
            os.unlink(temporary)

    with open(path + ".provenance", "w", encoding="utf-8") as note:
        note.write(provenance(model, path, model["url"]))
    print(f"{name}: {path} ({os.path.getsize(path)} bytes, sha256 verified)")
    return 0


def check(name, model, directory):
    path = os.path.join(directory, model["file"])
    if not os.path.exists(path):
        print(f"{name}: {path} is missing", file=sys.stderr)
        return 1
    actual = digest(path)
    if actual != model["sha256"]:
        print(f"{name}: {path} sha256 {actual} != {model['sha256']}",
              file=sys.stderr)
        return 1
    print(f"{name}: {path} verified")
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("model", nargs="?", default="sound",
                        choices=sorted(MODELS) + ["all"])
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--print", dest="show", action="store_true")
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--dir", default=None)
    options = parser.parse_args()

    directory = options.dir or models_dir()
    wanted = sorted(MODELS) if options.model == "all" else [options.model]

    if options.show:
        for name in wanted:
            model = MODELS[name]
            print(provenance(model, os.path.join(directory, model["file"]),
                             model["url"]))
        return 0

    status = 0
    for name in wanted:
        action = check if options.check else \
            (lambda n, m, d: fetch(n, m, d, options.force))
        status |= action(name, MODELS[name], directory)
    return status


if __name__ == "__main__":
    sys.exit(main())
